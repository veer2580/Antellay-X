# Static hashed assets built by Vite (e.g. JS & CSS bundles with content hash)
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable

# Static images in public/assets (must revalidate so changes reflect immediately)
/assets/landing/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/vision/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/mission/*
  Cache-Control: public, max-age=0, must-revalidate

# Favicon assets
/favicon*
  Cache-Control: public, max-age=604800

# Sitemaps & robots.txt (fresh for search engine crawlers)
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# Global Security & SEO Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
